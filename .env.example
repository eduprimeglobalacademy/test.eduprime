# Supabase project — safe to expose to the browser (VITE_ prefix), scoped by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — deliberately NOT VITE_-prefixed. Vite only inlines
# import.meta.env.VITE_* into the client bundle, so this name makes it
# structurally impossible for browser code to pick it up. Local/ops tooling
# only; never reference from src/ (see docs/standards/supabase-baas-engineering-standards.md #5).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain this app resolves org subdomains against, e.g. eduprime.app.
# Defaults to eduprime.app if unset.
VITE_ROOT_DOMAIN=eduprime.app
